# Локальные настройки и файлы, создаваемые скриптом при работе.
# В репозиторий не попадают.

# Настройки с API-ключом RouterAI
proxy_settings.json

# Кэш каталога моделей (пересобирается кнопкой «Обновить каталог»)
catalog_cache.json

# Лог работы прокси
proxy.log

# Выгружаемый кнопкой конфиг OpenCode и его бэкап
opencode.jsonc
opencode.jsonc.bak
*.bak

# Байт-код и кэш Python
__pycache__/
*.py[cod]
